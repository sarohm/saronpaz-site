---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Logos from '../components/Logos.astro';
import People from '../components/People.astro';
import site from '../data/site.json';

const projects = (await getCollection('projects', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('pages', (p) => p.data.kind === 'service')).sort((a, b) => a.data.order - b.data.order);
const excerpt = (s: string, n = 140) => {
  const t = s.split('\n\n')[0].replace(/\s+/g, ' ').trim();
  return t.length > n ? t.slice(0, t.lastIndexOf(' ', n)) + '…' : t;
};
// Two hero frames, each cycling through half of the portrait images.
const heroA = site.hero.filter((_: string, i: number) => i % 2 === 0);
const heroB = site.hero.filter((_: string, i: number) => i % 2 === 1);
---
<Base>
  <section class="hero wrap">
    <div class="frames">
      {[heroA, heroB].map((set, k) => (
        <div class="frame" data-rotate>
          {set.map((src: string, i: number) => (
            <img src={u(src)} alt="" class={i === 0 ? 'on' : ''} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 && k === 0 ? 'high' : 'auto'} />
          ))}
        </div>
      ))}
    </div>
    <h1 class="hero-title"><span>Saron</span><span>Paz</span></h1>
  </section>
  {/* The titles float near the name and fade out one by one while scrolling; all are gone when the projects start. */}
  <p class="floaters">
    {site.heroTitles.map((l: string, i: number) => <span class="floater" data-i={i}><span class="drift">{l}</span></span>)}
  </p>

  <section class="about">
    <div class="wrap">
      <h2 class="about-title">{site.about.title}</h2>
      <div class="ticker" aria-label={site.about.ticker}>
        <div class="ticker-track" aria-hidden="true">
          <span>{site.about.ticker}</span><span>{site.about.ticker}</span>
        </div>
      </div>
      <p class="about-text">{site.about.text}</p>
    </div>
  </section>

  <section class="services wrap" id="services">
    <h2 class="services-title">Services</h2>
    <ul role="list">
      {services.map((s) => (
        <li>
          <a href={u(`/${s.id}/`)}>
            <h3>{s.data.title}</h3>
            <p>{excerpt(s.body ?? '')}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {site.sections.map((sec: { id: string; title: string }) => (
    <ProjectGrid id={sec.id} title={sec.title} items={projects.filter((p) => p.data.section === sec.id)} />
  ))}

  <Logos id="partners" title="Partners" logos={site.partners} />
  <Logos id="clients" title="Clients" logos={site.clients} />
  <People id="friends" title="Talented Friends" people={site.friends} />
  <People id="talented" title="Just talented" people={site.talented} />
</Base>

<script>
  // Size the hero title so its height equals the image row's height.
  // Width and height of the title both grow linearly with the font size, so one measurement gives the answer.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const title = hero.querySelector<HTMLElement>('.hero-title')!;
  const frames = hero.querySelector<HTMLElement>('.frames')!;
  const fit = () => {
    title.style.removeProperty('--k');
    if (innerWidth <= 1000) return;
    const cs = getComputedStyle(hero);
    const W = hero.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    const colGap = parseFloat(cs.columnGap);
    const frameGap = parseFloat(getComputedStyle(frames).columnGap);
    const base = 100;
    title.style.setProperty('--k', base + 'px');
    const r = title.getBoundingClientRect();
    const a = r.width / base, b = r.height / base;
    // two square frames: height = (W - colGap - titleWidth - frameGap) / 2  =  title height
    const k = (W - colGap - frameGap) / (2 * b + a);
    title.style.setProperty('--k', k.toFixed(2) + 'px');
  };

  // Floating titles. Each is placed at a spot around the name (as fractions of the name's box, measured with the page at the top),
  // then fades out in turn as the page scrolls; the last one is gone when the first projects grid reaches the screen.
  const floaters = [...document.querySelectorAll<HTMLElement>('.floater')];
  // x, y: where each title starts, as fractions of the hero row (images + name). Titles fade out in this order.
  const spots = [
    { x: 0.03, y: 0.08 }, { x: 0.80, y: 0.47 }, { x: 0.30, y: 0.20 },
    { x: 0.87, y: 0.675 }, { x: 0.12, y: 0.48 }, { x: 0.42, y: 0.58 },
    { x: 0.81, y: 0.88 }, { x: 0.03, y: 0.82 }, { x: 0.38, y: 0.98 },
  ];
  const projects = document.querySelector<HTMLElement>('[data-grid]');
  let end = 1;
  const place = () => {
    const r = hero.getBoundingClientRect();
    const pad = parseFloat(getComputedStyle(hero).paddingLeft);
    const top = r.top + scrollY + parseFloat(getComputedStyle(hero).paddingTop);
    const box = { left: r.left + pad, width: r.width - 2 * pad, top, height: r.bottom + scrollY - top };
    const fs = Math.max(16, parseFloat(getComputedStyle(title).fontSize) * 0.16);
    floaters.forEach((f, i) => {
      const s = spots[i % spots.length];
      f.style.setProperty('--fs', fs + 'px');
      const w = f.offsetWidth;
      const x = Math.min(Math.max(8, box.left + s.x * box.width), innerWidth - w - 24);
      f.dataset.x = String(x);
      f.dataset.y = String(box.top + s.y * box.height - fs / 2);
    });
    end = Math.max(200, (projects ? projects.getBoundingClientRect().top + scrollY : innerHeight * 2) - innerHeight * 0.8);
    onScroll();
  };
  const onScroll = () => {
    // measured on every scroll, since images loading above the grid can move it
    if (projects) end = Math.max(200, projects.getBoundingClientRect().top + scrollY - innerHeight * 0.8);
    const p = Math.min(1, Math.max(0, scrollY / end));
    const n = floaters.length;
    floaters.forEach((f, i) => {
      // title i fades during its own slice of the scroll: [i/n, (i+1)/n]
      const t = Math.min(1, Math.max(0, (p / 0.95) * n - i));
      f.style.opacity = String(1 - t);
      f.style.visibility = t >= 1 ? 'hidden' : 'visible';
      f.style.transform = `translate(${f.dataset.x}px, ${parseFloat(f.dataset.y!) - t * 40}px)`;
      f.style.filter = t > 0 ? `blur(${(t * 6).toFixed(1)}px)` : '';
    });
  };
  const layout = () => { fit(); place(); };
  layout();
  document.fonts.ready.then(layout);
  addEventListener('resize', layout);
  addEventListener('scroll', onScroll, { passive: true });

  // Slow crossfade between hero portraits (skipped for people who prefer less motion).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-rotate]').forEach((frame, k) => {
      const imgs = [...frame.querySelectorAll('img')];
      let i = 0;
      setTimeout(() => setInterval(() => {
        imgs[i].classList.remove('on');
        i = (i + 1) % imgs.length;
        imgs[i].classList.add('on');
      }, 4200), k * 2100);
    });
  }
</script>

<style>
  /* Images on the left, title in the free column on the right. A script sizes the title so it is exactly as tall as the images. */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 44px; align-items: start; padding-top: 30px; }
  .frames { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
  .frame { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--soft); }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.4s ease; }
  .frame img.on { opacity: 1; }
  /* text-box trims the space above the capitals and below the baseline, so the letters line up with the image edges. */
  .hero-title { --k: clamp(30px, 3.9vw, 64px); margin: 0; text-align: left; font-family: var(--serif); font-weight: 900; line-height: .98; letter-spacing: -.02em; font-size: var(--k); text-box: trim-both cap alphabetic; }
  .hero-title span { display: block; }

  /* Floating titles: fixed to the screen, placed by the script around the name, faded by scroll position. */
  .floaters { margin: 0; }
  .floater { position: fixed; left: 0; top: 0; z-index: 25; pointer-events: none; white-space: nowrap; color: #fff; mix-blend-mode: difference;
    font-family: var(--serif); font-weight: 900; letter-spacing: -.02em; line-height: 1; font-size: var(--fs, 32px); will-change: opacity, transform; }
  .drift { display: inline-block; animation: drift 9s ease-in-out infinite alternate; }
  .floater:nth-child(3n+2) .drift { animation-duration: 11s; animation-delay: -4s; }
  .floater:nth-child(3n) .drift { animation-duration: 13s; animation-delay: -7s; animation-direction: alternate-reverse; }
  @keyframes drift {
    0% { transform: translate(0, 0) rotate(-2deg); }
    50% { transform: translate(14px, -10px) rotate(1deg); }
    100% { transform: translate(-10px, 8px) rotate(-1deg); }
  }
  @media (prefers-reduced-motion: reduce) { .drift { animation: none; } }

  .about { background: var(--soft); padding: 110px 0 100px; text-align: center; }
  .about-title { font-family: var(--sans); font-weight: 600; letter-spacing: .2em; text-transform: uppercase; font-size: 29px; margin: 0 0 22px; }
  .ticker { max-width: 940px; margin: 0 auto; border: 1px solid #ececec; background: #fff; overflow: hidden; padding: 14px 0; box-shadow: inset 0 2px 1px rgba(0,0,0,.024); }
  .ticker-track { display: flex; width: max-content; animation: tick 38s linear infinite; }
  .ticker-track span { font-family: var(--serif); font-weight: 700; font-size: 15px; letter-spacing: .38em; padding-right: 6em; white-space: nowrap; }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }
  .about-text { font-family: var(--serif); font-size: 20px; color: var(--muted); margin: 34px auto 0; max-width: 640px; }

  .services { display: grid; grid-template-columns: 1fr 1.6fr; gap: 54px; align-items: center; padding-top: 110px; padding-bottom: 20px; }
  .services-title { font-family: var(--serif); font-weight: 900; font-size: 72px; text-align: right; margin: 0; }
  .services ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 44px; }
  .services h3 { font-family: var(--serif); font-weight: 700; font-size: 29px; margin: 0 0 6px; }
  .services p { font-family: var(--serif); color: var(--muted); font-size: 17px; margin: 0; }
  .services a:hover h3 { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }


  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; gap: 40px; }
    .hero-title { --k: clamp(64px, 24vw, 140px) !important; }
    .services { grid-template-columns: 1fr; gap: 30px; }
    .services-title { text-align: left; font-size: clamp(54px, 15vw, 72px); }
  }
  @media (max-width: 700px) {
    .frames { gap: 18px; }
    .about { padding: 70px 0; }
    .services { padding-top: 70px; }
    .services h3 { font-size: 24px; }
  }
</style>
