---
import { u } from '../lib/url';
// A section of the homepage: giant title, tag filters, and a masonry grid of projects.
interface Item { id: string; data: { title: string; thumb: string; tags: string[] } }
interface Props { id: string; title: string; items: Item[]; intro?: string; link?: { label: string; url: string } }
import site from '../data/site.json';
const { id, title, items, intro, link } = Astro.props;
const rank = (t: string) => { const i = site.tagOrder.indexOf(t); return i < 0 ? 999 : i; };
const tags = [...new Set(items.flatMap((p) => p.data.tags))].sort((a, b) => rank(a) - rank(b));
const slugify = (t: string) => t.toLowerCase().replace(/\W+/g, '-');
---
<section class="projects" id={id} data-grid>
  <h2 class="giant">{title}</h2>
  {intro && <p class="intro">{intro}{link && <> <a href={link.url} target="_blank" rel="noopener">{link.label}</a></>}</p>}
  {tags.length > 1 && (
    <ul class="filters" role="list">
      <li><button class="eyebrow active" data-filter="*">Show all</button></li>
      {tags.map((t) => <li><button class="eyebrow" data-filter={slugify(t)}>{t}</button></li>)}
    </ul>
  )}
  <div class="masonry">
    {items.map((p) => (
      <a class="card" href={u(`/portfolio/${p.id}/`)} data-tags={p.data.tags.map(slugify).join(' ')}>
        {p.data.thumb && <img src={u(p.data.thumb)} alt="" loading="lazy" decoding="async" />}
        <h3>{p.data.title}</h3>
      </a>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-grid]').forEach((grid) => {
    const buttons = grid.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = grid.querySelectorAll<HTMLElement>('.card');
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.toggle('active', x === b));
      const f = b.dataset.filter!;
      cards.forEach((c) => { c.hidden = f !== '*' && !c.dataset.tags!.split(' ').includes(f); });
    }));
  });
</script>

<style>
  .intro { font-family: var(--serif); font-size: 19px; color: var(--muted); max-width: 720px; margin: -10px auto 40px; text-align: center; padding: 0 20px; }
  .intro a { color: var(--ink); border-bottom: 1px solid #ccc; white-space: nowrap; }
  .projects { padding: 110px 0 40px; }
  .filters { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 4px; padding: 0 36px; margin: 34px auto 54px; max-width: 1200px; }
  .filters button { background: none; border: 0; cursor: pointer; color: var(--ink); padding: 6px 9px; }
  .filters button.active, .filters button:hover { color: #999; }
  .masonry { columns: 6 170px; column-gap: 36px; padding: 0 36px; }
  .card { display: block; break-inside: avoid; margin-bottom: 36px; }
  .card[hidden] { display: none; }
  .card img { width: 100%; transition: opacity .25s, transform .4s; }
  .card:hover img { opacity: .82; }
  h3 { font-family: var(--serif); font-weight: 700; font-size: 17px; line-height: 1.3; margin: 14px 0 0; }
  @media (max-width: 700px) {
    .projects { padding-top: 70px; }
    .masonry { columns: 2; column-gap: 18px; padding: 0 20px; }
    .card { margin-bottom: 26px; }
    .filters { padding: 0 12px; margin: 24px auto 34px; }
  }
</style>
